set terminal svg
set output "fig1.svg"
set xlabel "x"
set ylabel "y"
set key right top
set tics out
set title "My figures"

plot[0.125:4]\
    "erf.data" using 1:2 with lines title "erf"\
    ,"erf.data" using 1:3 with lines title "gamma"\
    ,"erf.data" using 1:4 with lines title "ln(gamma)