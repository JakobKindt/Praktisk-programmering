 \
	set terminal svg ;\
	set output "fig_exp.svg" ;\
	set xlabel "Time (days)" ;\
	set ylabel "Activity" ;\
	set title "Fitting using OLS via QR" ;\
	a = real(system("awk 'NR==1{print $1}' fitting_parameters.txt")) ;\
	b = real(system("awk 'NR==2{print $1}' fitting_parameters.txt")) ;\
	aerr = real(system("awk 'NR==1{print $2}' fitting_parameters.txt")) ;\
	berr = real(system("awk 'NR==2{print $2}' fitting_parameters.txt")) ;\
	f(x) = exp(a)* exp(- b*x) ;\
	g(x) = exp(a - aerr) * exp(- (b + berr)*x) ;\
	h(x) = exp(a + aerr) *exp(- (b - berr)*x) ;\
	plot \
		"data.txt" using 1:2:3 with errorbars title "data", \
		f(x) with lines lt rgb "black" title sprintf("Fit using Aexp(- b*x), A=%.3f, b = %.3f", exp(a), b), \
		g(x) with lines dashtype 2 lt rgb "black" title "Uncertainty band", \
		h(x) with lines dashtype 2 lt rgb "black" title "" ;\

