\
set terminal svg ;\
set output "fig_fit.svg" ;\
set xlabel "x" ;\
set ylabel "y" ;\
set title "4 neurons fit to cos(5*x - 1) * exp(-x*x)" ;\
f(x) = cos(5*x - 1) * exp(-x*x) ;\
plot \
	"data.txt" using 1:2 index 0 with lines title "Fit", \
	"data.txt" using 1:2 index 1 with points title "Trainng data", \
	f(x) with lines title "Analytical f(x)" ;\

