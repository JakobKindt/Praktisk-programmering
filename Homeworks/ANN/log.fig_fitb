\
set terminal svg ;\
set output "fig_fitb.svg" ;\
set xlabel "x" ;\
set ylabel "y" ;\
set title "4 neurons fit to cos(5*x - 1) * exp(-x*x)" ;\
f(x) = cos(5*x - 1) * exp(-x*x) ;\
df(x) = -5*sin(5*x - 1)*exp(-x*x) - 2*x*f(x) ;\
ddf(x) = -25*cos(5*x - 1)*exp(-x*x) + 20*x*sin(5*x - 1)*exp(-x*x) + (4*x*x - 2)*f(x) ;\
plot \
	"data.txt" using 1:2 index 0 with lines title "Fit to f", \
	"data.txt" using 1:3 index 0 with lines title "Fit to F", \
	"data.txt" using 1:4 index 0 with lines title "Fit to df/dx", \
	"data.txt" using 1:5 index 0 with lines title "Fit to d^2f/dx^2", \
	f(x) with lines title "Analytical f(x)", \
	df(x) with lines title "Analytical df/dx", \
	ddf(x) with lines title "Analytical d^2f/dx^2" ;\

