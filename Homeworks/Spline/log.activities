 \
	set terminal svg ;\
	set output "Splines_cubic.svg" ;\
	set xlabel "x" ;\
	set ylabel "y" ;\
	set title "Fitting using Spline" ;\
	set key outside;\
	f(x) = cos(x) ;\
	F(x) = sin(x) ;\
	plot \
		f(x) with lines lt rgb "black" title "f(x) = cos(x)", \
		F(x) with lines lt rgb "black" title "F(x) = sin(x)", \
		"data_c.txt" using 4:5 with points title "Data", \
		"data_c.txt" using 1:2 with lines title "f(x) via Spline", \
		"data_c.txt" using 1:3 with lines title "F(x) via Spline" ;\

