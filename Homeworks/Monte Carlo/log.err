\
set terminal svg ;\
set output "fig_err.svg" ;\
set title "Error of integral of cos(theta) for 0 <= theta <= pi/2, 0 < r < 1 via MC" ;\
set xlabel "Amount of sample datapoints" ;\
set ylabel "err of integral" ;\
set logscale x ;\
a = 1 ;\
f(x) = a/sqrt(x) ;\
fit f(x) "err.txt" using 1:4 via a ;\
plot \
	"err.txt" using 1:3 with points title "Measured error", \
	"err.txt" using 1:4 with points title "Actual error", \
	f(x) with lines title sprintf("Fit to a/sqrt(N) fit, a = %3.5f", a);\

