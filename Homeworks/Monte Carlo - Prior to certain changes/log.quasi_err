\
set terminal svg ;\
set output "fig_quasi_err.svg" ;\
set title "Error of integral of unit circle via quasi MC" ;\
set xlabel "Amount of sample datapoints" ;\
set ylabel "err of integral" ;\
set logscale x ;\
a = 1 ;\
f(x) = a/sqrt(x) ;\
fit f(x) "quasi_err.txt" using 1:4 via a ;\
plot \
	"quasi_err.txt" using 1:3 with points title "Measured error", \
	"quasi_err.txt" using 1:4 with points title "Actual error", \
	f(x) with lines title sprintf("Fit to a/sqrt(N) fit, a = %3.5f", a) ;\

