\
set terminal svg ;\
set output "fig_fit.svg" ;\
set xlabel "x" ;\
set ylabel "y" ;\
set title "neurons = FIX" ;\
f(x) = cos(5*x - 1) * exp(-x*x) ;\
plot \
	"data.txt" using 1:2 with lines title "Fit", \
	"data.txt" using 1:3 with lines title "Calculated values", \
	f(x) with lines title "Theoretical cos(5*x - 1) * exp(-x*x)" ;\

